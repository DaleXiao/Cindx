{
  "schema": "cindx.fugu-evaluation-suite.v1",
  "id": "fugu-v1-parity",
  "version": 1,
  "description": "Frozen Fugu Ultra public-benchmark parity, iso-budget, and causal-ablation evaluation for Cindx.",
  "frozen_source": {
    "title": "Fugu: A Model Family for Agentic Intelligence",
    "version": "v1",
    "url": "https://arxiv.org/html/2606.21228v1",
    "results_table": "Technical Report v1, Table 1 and Appendix A",
    "frozen_on": "2026-07-23",
    "interpretation": "Fugu Ultra values are historical anchors, not direct claims, until the complete protocol-equivalent matrix is present."
  },
  "safety_policy": {
    "default_mode": "plan_only",
    "requires_explicit_execution": true,
    "sandbox_root_template": "${TMPDIR}/cindx-fugu-eval/{run_id}",
    "source_workspace_access": "read_only",
    "network_default": "disabled",
    "network_allowlist": [],
    "allow_destructive_tools": false,
    "allow_privileged_processes": false,
    "allow_symlink_escape": false,
    "max_parallel_processes": 2,
    "max_disk_bytes_per_run": 10737418240
  },
  "tracks": [
    {
      "id": "fugu_parity_quality_first",
      "kind": "quality_first",
      "description": "Protocol-equivalent quality comparison without optimizing for model cost.",
      "benchmark_ids": [
        "swe_bench_pro",
        "terminal_bench_2_1",
        "livecodebench_v6",
        "livecodebench_pro",
        "humanitys_last_exam",
        "charxiv",
        "gpqa_diamond",
        "scicode",
        "tau3_banking",
        "long_context_reasoning",
        "mrcr_v2"
      ],
      "treatment_ids": [
        "worker_conductor",
        "worker_planner",
        "worker_executor",
        "worker_reviewer",
        "fixed_ensemble",
        "cindx_fast",
        "cindx_auto",
        "cindx_pro"
      ],
      "seeds": [0, 1, 2],
      "readiness_required": true
    },
    {
      "id": "fugu_parity_iso_budget",
      "kind": "iso_budget",
      "description": "Matched comparison under one wall-time, call, tool, and token budget.",
      "benchmark_ids": [
        "swe_bench_pro",
        "terminal_bench_2_1",
        "livecodebench_v6",
        "livecodebench_pro",
        "humanitys_last_exam",
        "charxiv",
        "gpqa_diamond",
        "scicode",
        "tau3_banking",
        "long_context_reasoning",
        "mrcr_v2"
      ],
      "treatment_ids": [
        "worker_conductor",
        "worker_planner",
        "worker_executor",
        "worker_reviewer",
        "fixed_ensemble",
        "cindx_fast",
        "cindx_auto",
        "cindx_pro"
      ],
      "seeds": [0, 1, 2],
      "shared_budget": {
        "max_wall_time_ms": 7200000,
        "max_model_calls": 64,
        "max_tool_calls": 192,
        "max_total_tokens": 1000000
      },
      "readiness_required": true
    },
    {
      "id": "causal_ablation_quality_first",
      "kind": "causal_ablation",
      "description": "Paired causal tests of routing, GEPA, memory, verification, and four-channel retrieval.",
      "benchmark_ids": [
        "swe_bench_pro",
        "terminal_bench_2_1",
        "livecodebench_v6",
        "livecodebench_pro",
        "humanitys_last_exam",
        "charxiv",
        "gpqa_diamond",
        "scicode",
        "tau3_banking",
        "long_context_reasoning",
        "mrcr_v2"
      ],
      "treatment_ids": [
        "cindx_pro",
        "pro_no_router",
        "pro_no_gepa",
        "pro_no_memory",
        "pro_no_verifier",
        "pro_no_four_channel_retrieval",
        "pro_no_recovery"
      ],
      "seeds": [0, 1, 2],
      "readiness_required": true
    }
  ],
  "treatments": [
    {
      "id": "worker_conductor",
      "label": "Conductor worker",
      "kind": "single_worker",
      "description": "Configured Conductor model without collaboration."
    },
    {
      "id": "worker_planner",
      "label": "Planner worker",
      "kind": "single_worker",
      "description": "Configured Planner model without collaboration."
    },
    {
      "id": "worker_executor",
      "label": "Executor worker",
      "kind": "single_worker",
      "description": "Configured Executor model without collaboration."
    },
    {
      "id": "worker_reviewer",
      "label": "Reviewer worker",
      "kind": "single_worker",
      "description": "Configured Reviewer model without collaboration."
    },
    {
      "id": "fixed_ensemble",
      "label": "Fixed ensemble",
      "kind": "fixed_ensemble",
      "description": "All configured workers run with a fixed, non-adaptive topology."
    },
    {
      "id": "cindx_fast",
      "label": "Cindx Fast",
      "kind": "cindx_fast",
      "description": "Latency-first Cindx routing."
    },
    {
      "id": "cindx_auto",
      "label": "Cindx Auto",
      "kind": "cindx_auto",
      "description": "Intent- and complexity-aware Cindx routing."
    },
    {
      "id": "cindx_pro",
      "label": "Cindx Pro",
      "kind": "cindx_pro",
      "description": "Quality-first adaptive multi-model Cindx orchestration."
    },
    {
      "id": "pro_no_router",
      "label": "Pro without learned routing",
      "kind": "ablation",
      "description": "Cindx Pro with a fixed topology instead of intelligent routing.",
      "base_treatment_id": "cindx_pro"
    },
    {
      "id": "pro_no_gepa",
      "label": "Pro without GEPA",
      "kind": "ablation",
      "description": "Cindx Pro pinned to the frozen pre-evolution harness profile.",
      "base_treatment_id": "cindx_pro"
    },
    {
      "id": "pro_no_memory",
      "label": "Pro without durable memory",
      "kind": "ablation",
      "description": "Cindx Pro with cross-session memory production and recall disabled.",
      "base_treatment_id": "cindx_pro"
    },
    {
      "id": "pro_no_verifier",
      "label": "Pro without verification",
      "kind": "ablation",
      "description": "Cindx Pro without reviewer and deterministic verifier feedback.",
      "base_treatment_id": "cindx_pro"
    },
    {
      "id": "pro_no_four_channel_retrieval",
      "label": "Pro without four-channel retrieval",
      "kind": "ablation",
      "description": "Cindx Pro without fused vector, graph-keyword, graph-walk, and file recall.",
      "base_treatment_id": "cindx_pro"
    },
    {
      "id": "pro_no_recovery",
      "label": "Pro without recovery",
      "kind": "ablation",
      "description": "Cindx Pro without checkpoint recovery, bounded retry, or resume logic.",
      "base_treatment_id": "cindx_pro"
    }
  ],
  "benchmarks": [
