{
  "schema": "cindx.quality-gates.v1",
  "id": "foundation",
  "version": 1,
  "priority_order": [
    "evaluation_contract",
    "correctness_and_recovery",
    "performance",
    "cost_observability_only"
  ],
  "limitations": [
    "Deterministic gates do not prove provider-backed answer quality.",
    "Evaluation v2 promotion remains blocked until feedback, Pareto, and hidden test evidence are supplied.",
    "Gate durations are diagnostic and are not portable latency thresholds."
  ],
  "profiles": {
    "quick": [
      "version-contract",
      "desktop-layout",
      "desktop-structure"
    ],
    "ci-contract": [
      "version-contract",
      "desktop-layout",
      "desktop-structure",
      "performance-comparator-contract",
      "routing-contract",
      "evaluation-foundation",
      "agent-arena-contract",
      "memory-contract",
      "frontend-test"
    ],
    "control-plane": [
      "routing-contract",
      "evaluation-foundation",
      "agent-arena-contract",
      "memory-contract",
      "workspace-tests",
      "desktop-tests"
    ],
    "performance": [
      "performance-comparator-contract",
      "session-projection-scaling",
      "agent-runtime-snapshot-scaling",
      "workspace-graph-cache-scaling",
      "prepared-image-request-scaling",
      "model-transport-prepare-scaling",
      "frontend-streaming-markdown-scaling",
      "context-governor-scaling",
      "conductor-health-scaling",
      "rag-search-scaling"
    ],
    "shipping-performance": [
      "session-projection-scaling",
      "agent-runtime-snapshot-scaling",
      "workspace-graph-cache-scaling",
      "prepared-image-request-scaling",
      "model-transport-prepare-scaling",
      "frontend-streaming-markdown-scaling"
    ],
    "full": [
      "version-contract",
      "desktop-layout",
      "desktop-structure",
      "performance-comparator-contract",
      "browser-sidecar",
      "computer-sidecar",
      "routing-contract",
      "evaluation-foundation",
      "agent-arena-contract",
      "memory-contract",
      "workspace-tests",
      "desktop-tests",
      "frontend-test",
      "session-projection-scaling",
      "agent-runtime-snapshot-scaling",
      "workspace-graph-cache-scaling",
      "prepared-image-request-scaling",
      "model-transport-prepare-scaling",
      "frontend-streaming-markdown-scaling",
      "frontend-build"
    ]
  },
  "gates": [
    {
      "id": "version-contract",
      "category": "release",
      "command": ["node", "scripts/check-release-version.mjs"]
    },
    {
      "id": "desktop-layout",
      "category": "ux",
      "command": ["node", "scripts/check-desktop-layout.mjs"]
    },
    {
      "id": "desktop-structure",
      "category": "ux_and_architecture",
      "command": ["node", "scripts/check-desktop-structure.mjs"]
    },
    {
      "id": "performance-comparator-contract",
      "category": "performance",
      "command": ["node", "--test", "scripts/performance-comparison.test.mjs"]
    },
    {
      "id": "browser-sidecar",
      "category": "tools",
      "command": ["node", "scripts/test-browser-sidecar.mjs"]
    },
    {
      "id": "computer-sidecar",
      "category": "tools",
      "command": ["node", "scripts/test-computer-sidecar.mjs"]
    },
    {
      "id": "routing-contract",
      "category": "evaluation_contract",
      "command": [
        "cargo",
        "run",
        "--locked",
        "-p",
        "orchestrator-eval",
        "--example",
        "evaluation_lab",
        "--",
        "--report",
        "target/agent-benchmark-report.json"
      ],
      "report": "target/agent-benchmark-report.json",
      "assertions": [
        { "path": "baseline_passed", "equals": true },
        { "path": "contract.pass_rate", "equals": 1 },
        { "path": "contract.over_orchestrated", "equals": 0 },
        { "path": "contract.under_orchestrated", "equals": 0 }
      ]
    },
    {
      "id": "evaluation-foundation",
      "category": "gepa",
      "command": [
        "cargo",
        "run",
        "--locked",
        "-p",
        "orchestrator-eval",
        "--example",
        "evaluation_v2_lab",
        "--",
        "--report",
        "target/evaluation-v2-foundation.json"
      ],
      "report": "target/evaluation-v2-foundation.json",
      "assertions": [
        { "path": "routing_contract_verified", "equals": true }
      ]
    },
    {
      "id": "agent-arena-contract",
      "category": "evaluation_contract",
      "command": [
        "cargo",
        "run",
        "--locked",
        "-p",
        "orchestrator-eval",
        "--example",
        "arena_lab",
        "--",
        "--report",
        "target/agent-arena-contract.json"
      ],
      "report": "target/agent-arena-contract.json",
      "assertions": [
        { "path": "cases", "equals": 120 },
        { "path": "observed_runs", "equals": 0 },
        { "path": "missing_runs", "equals_path": "required_observations" },
        { "path": "ready_for_scientific_comparison", "equals": false }
      ]
    },
    {
      "id": "memory-contract",
      "category": "memory",
      "command": [
        "cargo",
        "run",
        "--locked",
        "-p",
        "agent-memory",
        "--example",
        "memory_lab",
        "--",
        "--report",
        "target/memory-evaluation.json"
      ],
      "report": "target/memory-evaluation.json",
      "assertions": [
        { "path": "top_1_correct", "equals_path": "cases" },
        { "path": "recall_at_3_correct", "equals_path": "cases" },
        { "path": "trust_violations", "equals": 0 },
        { "path": "dedup_failures", "equals": 0 },
        { "path": "supersession_failures", "equals": 0 },
        { "path": "false_positive_failures", "equals": 0 },
        { "path": "false_persistence_failures", "equals": 0 },
        { "path": "verbatim_evidence_failures", "equals": 0 },
        { "path": "semantic_laundering_failures", "equals": 0 },
        { "path": "security_cases", "equals": 6 },
        { "path": "security_case_failures", "equals": 0 }
      ]
    },
    {
      "id": "workspace-tests",
      "category": "correctness",
      "command": ["cargo", "test", "--workspace", "--locked"]
    },
    {
      "id": "desktop-tests",
      "category": "control_plane",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml",
        "--locked"
      ]
    },
    {
      "id": "frontend-test",
      "category": "ux_and_state",
      "cwd": "apps/desktop",
      "command": ["npm", "test"]
    },
    {
      "id": "frontend-build",
      "category": "ux",
      "cwd": "apps/desktop",
      "command": ["npm", "run", "build"]
    },
    {
      "id": "session-projection-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml",
        "--locked",
        "session_projection::tests::incremental_projection_reads_only_the_target_session_delta",
        "--",
        "--exact",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.session-projection-diagnostic.v1"
      ]
    },
    {
      "id": "context-governor-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "agent-runtime",
        "context_governor::tests::long_history_context_governor_scaling_diagnostic",
        "--",
        "--exact",
        "--ignored",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.context-governor-diagnostic.v1"
      ]
    },
    {
      "id": "agent-runtime-snapshot-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml",
        "--locked",
        "agent_runtime_snapshot_cursor::tests::incremental_runtime_snapshot_visits_only_appended_messages",
        "--",
        "--exact",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.agent-runtime-snapshot-scaling.v1"
      ]
    },
    {
      "id": "workspace-graph-cache-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml",
        "--locked",
        "tests::workspace_knowledge_snapshot_reuses_one_graph_parse_and_borrowed_projection",
        "--",
        "--exact",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.workspace-graph-cache-scaling.v1"
      ]
    },
    {
      "id": "prepared-image-request-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "model-provider",
        "prepared_request::tests::prepared_streaming_body_matches_canonical_json_and_shares_bytes",
        "--",
        "--exact",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.prepared-image-request-scaling.v1"
      ]
    },
    {
      "id": "model-transport-prepare-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml",
        "--locked",
        "agent_model_turn_runtime::tests::transport_attempts_prepare_model_request_once",
        "--",
        "--exact",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.model-transport-prepare-scaling.v1"
      ]
    },
    {
      "id": "frontend-streaming-markdown-scaling",
      "category": "performance",
      "cwd": "apps/desktop",
      "command": [
        "node",
        "--test",
        "--test-name-pattern",
        "keeps rope string work linear across an eight MiB unbroken line",
        "tests/streamingMarkdownModel.test.ts"
      ],
      "required_output": [
        "# pass 1",
        "cindx.frontend-streaming-markdown-scaling.v1"
      ]
    },
    {
      "id": "conductor-health-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml",
        "--locked",
        "conductor_health_runtime::tests::conductor_health_scaling_diagnostic",
        "--",
        "--exact",
        "--ignored",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.conductor-health-diagnostic.v1"
      ]
    },
    {
      "id": "rag-search-scaling",
      "category": "performance",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "agent-rag",
        "tests::synthetic_rag_search_scaling_diagnostic",
        "--",
        "--exact",
        "--ignored",
        "--nocapture"
      ],
      "required_output": [
        "test result: ok. 1 passed; 0 failed",
        "cindx.rag-search-diagnostic.v1"
      ]
    }
  ]
}
