      "id": "routing-contract",
      "category": "evaluation_contract",
      "command": [
        "cargo",
        "run",
        "--locked",
        "-p",
        "orchestrator-eval",
        "--example",
        "evaluation_lab",
        "--",
        "--report",
        "target/agent-benchmark-report.json"
      ],
      "report": "target/agent-benchmark-report.json",
      "assertions": [
        {
          "path": "baseline_passed",
          "equals": true
        },
        {
          "path": "contract.pass_rate",
          "equals": 1
        },
        {
          "path": "contract.over_orchestrated",
          "equals": 0
        },
        {
          "path": "contract.under_orchestrated",
          "equals": 0
        }
      ]
    },
