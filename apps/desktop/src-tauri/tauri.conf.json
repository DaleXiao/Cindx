{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cindx",
  "version": "0.0.8",
  "identifier": "app.cindx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cindx",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 28
        },
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:5173",
        "script-src": "'self' 'unsafe-inline' http://127.0.0.1:5173",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../scripts/sidecars/browser-sidecar.js": "sidecars/browser-sidecar.js",
      "../../../scripts/sidecars/computer-sidecar.js": "sidecars/computer-sidecar.js"
    }
  }
}
